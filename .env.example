# Backend (read by backend/koi/config.py). All optional; defaults shown.
KOI_DB_PATH=backend/data/koi.db
KOI_OLLAMA_URL=http://127.0.0.1:11434
KOI_OLLAMA_MODEL=llama3.1:8b
KOI_OLLAMA_TIMEOUT_S=90
KOI_FUNDAMENTALS_TTL_H=168
KOI_PRICE_TTL_H=6
KOI_COMPANY_MASTER_TTL_H=168
KOI_SOURCE_MIN_INTERVAL_S=1.5
KOI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DCF default assumptions (user-adjustable per request in Advanced mode)
KOI_DCF_RISK_FREE=0.07
KOI_DCF_ERP=0.06
KOI_DCF_TERMINAL_GROWTH=0.05
KOI_DCF_TAX_RATE=0.25

# Frontend (put in frontend/.env.local). Public by design: it is only the backend URL, never a secret.
NEXT_PUBLIC_KOI_API=http://127.0.0.1:8000
